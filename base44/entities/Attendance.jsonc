{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "classroom_id": {
      "type": "string",
      "description": "Reference to Classroom"
    },
    "student_id": {
      "type": "string",
      "description": "Reference to Student"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de asistencia"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "excused"
      ],
      "default": "present",
      "description": "Estado de asistencia"
    },
    "reason": {
      "type": "string",
      "description": "Raz\u00f3n de ausencia o retraso"
    },
    "recorded_by": {
      "type": "string",
      "description": "User ID who recorded attendance"
    },
    "recorded_by_name": {
      "type": "string",
      "description": "Name of user who recorded"
    },
    "parent_notified": {
      "type": "boolean",
      "default": false,
      "description": "Si se notific\u00f3 a los padres"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cu\u00e1ndo se notific\u00f3"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "date",
    "status",
    "recorded_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.recorded_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.recorded_by": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recorded_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}