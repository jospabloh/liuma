{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "classroom_id": {
      "type": "string",
      "description": "Reference to Classroom"
    },
    "student_id": {
      "type": "string",
      "description": "Reference to Student"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de asistencia"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "excused"
      ],
      "default": "present",
      "description": "Estado de asistencia"
    },
    "reason": {
      "type": "string",
      "description": "Razón de ausencia o retraso"
    },
    "recorded_by": {
      "type": "string",
      "description": "User ID who recorded attendance"
    },
    "recorded_by_name": {
      "type": "string",
      "description": "Name of user who recorded"
    },
    "parent_notified": {
      "type": "boolean",
      "default": false,
      "description": "Si se notificó a los padres"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cuándo se notificó"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "date",
    "status",
    "recorded_by"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "TEACHER"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}",
              "data.classroom_id": {
                "$in": "{{user.data.assigned_classroom_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "PARENT"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}",
              "data.student_id": {
                "$in": "{{user.data.linked_student_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    }
  }
}
