{
  "name": "AuditLog",
  "properties": {
    "action": {
      "enum": [
        "USER_APPROVED",
        "USER_SUSPENDED",
        "PARENT_LINKED",
        "PARENT_UNLINKED",
        "NOTICE_SENT",
        "DIARY_CREATED",
        "DIARY_SENT",
        "PAYMENT_RECORDED",
        "CHARGE_CREATED",
        "EMERGENCY_ALERT",
        "STUDENT_CREATED",
        "CLASSROOM_CREATED",
        "ATTENDANCE_BULK_PRESENT",
        "PERMISSION_CHANGE",
        "POLICY_DECISION",
        "owner_override",
        "access_denied",
        "ROLE_CHANGE",
        "ROLE_CHANGE_REQUESTED",
        "ROLE_CHANGE_REVIEW",
        "ROLE_CHANGED_OWNER_BYPASS",
        "LICENSE_UPDATED",
        "PRIVACY_CONSENT_ACCEPTED",
        "AI_REQUEST_ALLOWED",
        "AI_REQUEST_DENIED",
        "SUPPORT_TICKET_CREATED",
        "SUPPORT_TICKET_MESSAGE",
        "SUPPORT_TICKET_STATUS_CHANGE",
        "THEME_CREATED_OR_UPDATED",
        "NOTIFICATION_DELIVERY_FAILED"
      ],
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "ip_address": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "user_id",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
