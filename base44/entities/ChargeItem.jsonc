{
  "name": "ChargeItem",
  "properties": {
    "amount": {
      "description": "Monto final a pagar (original_amount - discount_amount). Lo calcula guardedEntityWrite al crear el cargo y ya no cambia.",
      "type": "number"
    },
    "amount_paid": {
      "default": 0,
      "description": "Suma de los PaymentRecord del cargo. La recalcula guardedEntityWrite (settleCharge) despu\u00e9s de cada pago o pago borrado; nunca la escribe un cliente.",
      "type": "number",
      "rls": {
        "write": false
      }
    },
    "concept_id": {
      "type": "string"
    },
    "concept_name": {
      "type": "string"
    },
    "concept_type": {
      "default": "OTRO",
      "enum": [
        "INSCRIPCION",
        "COLEGIATURA",
        "HORARIO_EXTENDIDO",
        "EVENTO",
        "OTRO"
      ],
      "type": "string"
    },
    "discount_amount": {
      "default": 0,
      "description": "Monto del descuento aplicado",
      "type": "number"
    },
    "discount_id": {
      "description": "Reference to Discount aplicado",
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "last_payment_date": {
      "description": "Fecha del pago m\u00e1s reciente del cargo. La escribe guardedEntityWrite (settleCharge).",
      "format": "date",
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "last_reminder_at": {
      "description": "Cu\u00e1ndo se envi\u00f3 el \u00faltimo recordatorio de pago. Lo escribe sendBulkNotification; limita el recordatorio manual a uno por d\u00eda.",
      "format": "date-time",
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "reminder_claim_id": {
      "description": "Recordatorio de pago en curso: id del env\u00edo que lo reclam\u00f3. Lo escribe y lo limpia sendBulkNotification (claimChargeReminder); vac\u00edo cuando no hay env\u00edo en curso.",
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "event_id": {
      "description": "Reference to Event si es pago de evento",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "original_amount": {
      "description": "Monto original sin descuentos",
      "type": "number"
    },
    "reminder_sent": {
      "default": false,
      "description": "Si ya se envi\u00f3 recordatorio de pago",
      "type": "boolean"
    },
    "school_id": {
      "type": "string"
    },
    "status": {
      "default": "PENDING",
      "description": "Lo deriva guardedEntityWrite de los pagos y la fecha de vencimiento: PAID cuando amount_paid >= amount; si no, OVERDUE si due_date ya pas\u00f3 (d\u00eda de M\u00e9xico); si no, PARTIAL con alg\u00fan pago o PENDING sin pagos. CANCELLED s\u00f3lo lo pone la direcci\u00f3n.",
      "enum": [
        "PENDING",
        "PARTIAL",
        "PAID",
        "OVERDUE",
        "CANCELLED"
      ],
      "type": "string"
    },
    "student_id": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "concept_name",
    "amount",
    "due_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}