{
  "name": "ChargeItem",
  "properties": {
    "amount": {
      "description": "Monto final a pagar",
      "type": "number"
    },
    "concept_id": {
      "type": "string"
    },
    "concept_name": {
      "type": "string"
    },
    "concept_type": {
      "default": "OTRO",
      "enum": [
        "INSCRIPCION",
        "COLEGIATURA",
        "HORARIO_EXTENDIDO",
        "EVENTO",
        "OTRO"
      ],
      "type": "string"
    },
    "discount_amount": {
      "default": 0,
      "description": "Monto del descuento aplicado",
      "type": "number"
    },
    "discount_id": {
      "description": "Reference to Discount aplicado",
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "event_id": {
      "description": "Reference to Event si es pago de evento",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "original_amount": {
      "description": "Monto original sin descuentos",
      "type": "number"
    },
    "reminder_sent": {
      "default": false,
      "description": "Si ya se envi\u00f3 recordatorio de pago",
      "type": "boolean"
    },
    "school_id": {
      "type": "string"
    },
    "status": {
      "default": "PENDING",
      "description": "OVERDUE se actualiza autom\u00e1ticamente",
      "enum": [
        "PENDING",
        "PAID",
        "OVERDUE",
        "CANCELLED"
      ],
      "type": "string"
    },
    "student_id": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "concept_name",
    "amount",
    "due_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}