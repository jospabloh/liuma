{
  "name": "Classroom",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "name": {
      "type": "string",
      "description": "Classroom name (e.g., '1-A', 'Preescolar Azul')"
    },
    "grade": {
      "type": "string",
      "description": "Grade level"
    },
    "capacity": {
      "type": "number",
      "description": "Maximum students"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}",
                  "id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "PARENT"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}",
                  "id": {
                    "$in": "{{user.data.linked_student_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
