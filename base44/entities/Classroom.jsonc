{
  "name": "Classroom",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "name": {
      "type": "string",
      "description": "Classroom name (e.g., '1-A', 'Preescolar Azul')"
    },
    "grade": {
      "type": "string",
      "description": "Grade level"
    },
    "capacity": {
      "type": "number",
      "description": "Maximum students"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}