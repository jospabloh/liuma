{
  "name": "Classroom",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "name": {
      "type": "string",
      "description": "Classroom name (e.g., '1-A', 'Preescolar Azul')"
    },
    "grade": {
      "type": "string",
      "description": "Grade level"
    },
    "capacity": {
      "type": "number",
      "description": "Maximum students"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "TEACHER"
          },
          "_id": {
            "$in": "{{user.data.assigned_classroom_ids}}"
          }
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "PARENT"
          },
          "_id": {
            "$in": "{{user.data.linked_student_classroom_ids}}"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    }
  }
}