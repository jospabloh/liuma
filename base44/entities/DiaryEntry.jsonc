{
  "name": "DiaryEntry",
  "properties": {
    "bathroom": {
      "description": "Informaci\u00f3n sobre ba\u00f1o",
      "type": "string"
    },
    "bathroom_pipi": {
      "default": false,
      "description": "HOY HICE - Pip\u00ed",
      "type": "boolean"
    },
    "bathroom_popo": {
      "default": false,
      "description": "HOY HICE - Pop\u00f3",
      "type": "boolean"
    },
    "behavior": {
      "description": "Comportamiento general (opcional - para primaria)",
      "enum": [
        "excelente",
        "bueno",
        "regular",
        "necesita_apoyo"
      ],
      "type": "string"
    },
    "classroom_id": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "food": {
      "description": "Cantidad de comida (opcional - alternativa a food_mood)",
      "enum": [
        "todo",
        "casi_todo",
        "poco",
        "nada"
      ],
      "type": "string"
    },
    "food_mood": {
      "description": "HOY COM\u00cd - C\u00f3mo comi\u00f3 el alumno (carita)",
      "enum": [
        "feliz",
        "neutral",
        "triste"
      ],
      "type": "string"
    },
    "general_mood": {
      "description": "HOY ESTUVE - Estado de \u00e1nimo general (carita)",
      "enum": [
        "feliz",
        "neutral",
        "triste"
      ],
      "type": "string"
    },
    "homework_completed": {
      "type": "boolean"
    },
    "incidents": {
      "description": "Incidentes adicionales",
      "type": "string"
    },
    "learning": {
      "description": "Evaluaci\u00f3n de aprendizaje (opcional - para primaria)",
      "enum": [
        "excelente",
        "bueno",
        "regular",
        "necesita_apoyo"
      ],
      "type": "string"
    },
    "mood": {
      "description": "Estado de \u00e1nimo detallado (opcional)",
      "enum": [
        "feliz",
        "tranquilo",
        "cansado",
        "inquieto",
        "triste"
      ],
      "type": "string"
    },
    "naps": {
      "description": "Informaci\u00f3n sobre siestas",
      "type": "string"
    },
    "needs_clothes": {
      "default": false,
      "description": "NECESITO - Muda de ropa",
      "type": "boolean"
    },
    "needs_diapers": {
      "default": false,
      "description": "NECESITO - Pa\u00f1ales",
      "type": "boolean"
    },
    "needs_ointment": {
      "default": false,
      "description": "NECESITO - Pomada",
      "type": "boolean"
    },
    "needs_other": {
      "description": "NECESITO - Otro (texto libre)",
      "type": "string"
    },
    "notes_text": {
      "description": "MI MAESTRA DICE - Notas principales del d\u00eda",
      "type": "string"
    },
    "parent_notes": {
      "description": "MIS PAP\u00c1S DICEN - Respuesta de los padres",
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "type": "string"
    },
    "sent_to_parents": {
      "default": false,
      "type": "boolean"
    },
    "sleep_hours": {
      "description": "HOY DORM\u00cd - Horas",
      "type": "number"
    },
    "sleep_minutes": {
      "description": "HOY DORM\u00cd - Minutos",
      "type": "number"
    },
    "student_id": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "teacher_message": {
      "description": "Mensajito especial de la maestra para el alumno",
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "uniform_status": {
      "description": "UNIFORME - Estado del uniforme (carita feliz/triste)",
      "enum": [
        "limpio",
        "sucio"
      ],
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "date",
    "teacher_id",
    "notes_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}