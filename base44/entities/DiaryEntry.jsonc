{
  "name": "DiaryEntry",
  "properties": {
    "bathroom": {
      "description": "Información sobre baño",
      "type": "string"
    },
    "bathroom_pipi": {
      "default": false,
      "description": "HOY HICE - Pipí",
      "type": "boolean"
    },
    "bathroom_popo": {
      "default": false,
      "description": "HOY HICE - Popó",
      "type": "boolean"
    },
    "behavior": {
      "description": "Comportamiento general (opcional - para primaria)",
      "enum": [
        "excelente",
        "bueno",
        "regular",
        "necesita_apoyo"
      ],
      "type": "string"
    },
    "classroom_id": {
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "food": {
      "description": "Cantidad de comida (opcional - alternativa a food_mood)",
      "enum": [
        "todo",
        "casi_todo",
        "poco",
        "nada"
      ],
      "type": "string"
    },
    "food_mood": {
      "description": "HOY COMÍ - Cómo comió el alumno (carita)",
      "enum": [
        "feliz",
        "neutral",
        "triste"
      ],
      "type": "string"
    },
    "general_mood": {
      "description": "HOY ESTUVE - Estado de ánimo general (carita)",
      "enum": [
        "feliz",
        "neutral",
        "triste"
      ],
      "type": "string"
    },
    "homework_completed": {
      "type": "boolean"
    },
    "incidents": {
      "description": "Incidentes adicionales",
      "type": "string"
    },
    "learning": {
      "description": "Evaluación de aprendizaje (opcional - para primaria)",
      "enum": [
        "excelente",
        "bueno",
        "regular",
        "necesita_apoyo"
      ],
      "type": "string"
    },
    "mood": {
      "description": "Estado de ánimo detallado (opcional)",
      "enum": [
        "feliz",
        "tranquilo",
        "cansado",
        "inquieto",
        "triste"
      ],
      "type": "string"
    },
    "naps": {
      "description": "Información sobre siestas",
      "type": "string"
    },
    "needs_clothes": {
      "default": false,
      "description": "NECESITO - Muda de ropa",
      "type": "boolean"
    },
    "needs_diapers": {
      "default": false,
      "description": "NECESITO - Pañales",
      "type": "boolean"
    },
    "needs_ointment": {
      "default": false,
      "description": "NECESITO - Pomada",
      "type": "boolean"
    },
    "needs_other": {
      "description": "NECESITO - Otro (texto libre)",
      "type": "string"
    },
    "notes_text": {
      "description": "MI MAESTRA DICE - Notas principales del día",
      "type": "string"
    },
    "parent_notes": {
      "description": "MIS PAPÁS DICEN - Respuesta de los padres",
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "type": "string"
    },
    "sent_to_parents": {
      "default": false,
      "type": "boolean"
    },
    "sleep_hours": {
      "description": "HOY DORMÍ - Horas",
      "type": "number"
    },
    "sleep_minutes": {
      "description": "HOY DORMÍ - Minutos",
      "type": "number"
    },
    "student_id": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "teacher_message": {
      "description": "Mensajito especial de la maestra para el alumno",
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "uniform_status": {
      "description": "UNIFORME - Estado del uniforme (carita feliz/triste)",
      "enum": [
        "limpio",
        "sucio"
      ],
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "date",
    "teacher_id",
    "notes_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.app_role": "TEACHER"
                      }
                    },
                    {
                      "data.classroom_id": {
                        "$in": "{{user.data.assigned_classroom_ids}}"
                      }
                    },
                    {
                      "data.teacher_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}"
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "PARENT"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}"
                },
                {
                  "data.student_id": {
                    "$in": "{{user.data.linked_student_ids}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.teacher_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}
