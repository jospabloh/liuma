{
  "name": "EmergencyContact",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "is_authorized_pickup": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "added_by_user_id": {
      "type": "string",
      "description": "Quién agregó el contacto. Lo fija guardedFamilyWrite (service role): desde P7 el registro lo crea el service role, así que created_by_id ya no es el padre y la regla de lectura necesita este campo para que siga viendo lo que agregó (P7, 2026-09-29).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "student_id",
    "school_id",
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.added_by_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}