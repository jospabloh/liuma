{
  "name": "Event",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "SCHOOL",
        "CLASSROOM"
      ],
      "default": "SCHOOL"
    },
    "classroom_id": {
      "type": "string"
    },
    "requires_confirmation": {
      "type": "boolean",
      "default": false,
      "description": "Si requiere confirmación de asistencia"
    },
    "has_cost": {
      "type": "boolean",
      "default": false,
      "description": "Si tiene costo asociado"
    },
    "cost_amount": {
      "type": "number",
      "description": "Monto del costo"
    },
    "cost_concept": {
      "type": "string",
      "description": "Concepto del pago"
    },
    "confirmation_deadline": {
      "type": "string",
      "format": "date",
      "description": "Fecha límite para confirmar"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "school_id",
    "title",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.scope": "SCHOOL"
                },
                {
                  "$and": [
                    {
                      "data.scope": "CLASSROOM"
                    },
                    {
                      "data.classroom_id": {
                        "$in": "{{user.data.assigned_classroom_ids}}"
                      }
                    }
                  ]
                },
                {
                  "$and": [
                    {
                      "data.scope": "CLASSROOM"
                    },
                    {
                      "data.classroom_id": {
                        "$in": "{{user.data.linked_student_classroom_ids}}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}