{
  "name": "Homework",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "classroom_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_date": {
      "type": "string",
      "format": "date"
    },
    "teacher_id": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "school_id",
    "classroom_id",
    "title",
    "due_date",
    "teacher_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.app_role": "TEACHER"
                      }
                    },
                    {
                      "data.classroom_id": {
                        "$in": "{{user.data.assigned_classroom_ids}}"
                      }
                    },
                    {
                      "data.teacher_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$or": [
            {
              "data.school_id": "{{user.data.school_id}}",
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}"
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "PARENT"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}"
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.linked_student_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.teacher_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}