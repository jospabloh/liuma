{
  "name": "Notice",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "SCHOOL",
        "CLASSROOM",
        "STUDENT"
      ],
      "default": "SCHOOL"
    },
    "classroom_id": {
      "type": "string",
      "description": "Required if scope is CLASSROOM"
    },
    "student_id": {
      "type": "string",
      "description": "Required if scope is STUDENT"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "NORMAL",
        "IMPORTANT",
        "URGENT"
      ],
      "default": "NORMAL"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_emergency": {
      "type": "boolean",
      "default": false
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "school_id",
    "title",
    "content",
    "author_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}