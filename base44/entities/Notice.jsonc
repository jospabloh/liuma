{
  "name": "Notice",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "SCHOOL",
        "CLASSROOM",
        "STUDENT"
      ],
      "default": "SCHOOL"
    },
    "classroom_id": {
      "type": "string",
      "description": "Required if scope is CLASSROOM"
    },
    "student_id": {
      "type": "string",
      "description": "Required if scope is STUDENT"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "NORMAL",
        "IMPORTANT",
        "URGENT"
      ],
      "default": "NORMAL"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_emergency": {
      "type": "boolean",
      "default": false
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "school_id",
    "title",
    "content",
    "author_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.app_role": "TEACHER"
                      }
                    },
                    {
                      "data.scope": "CLASSROOM"
                    },
                    {
                      "data.classroom_id": {
                        "$in": "{{user.data.assigned_classroom_ids}}"
                      }
                    },
                    {
                      "data.author_id": "{{user.id}}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  },
                  "data.scope": "SCHOOL"
                },
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  },
                  "data.scope": "CLASSROOM",
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                },
                {
                  "user_condition": {
                    "data.app_role": "PARENT"
                  },
                  "data.scope": "SCHOOL"
                },
                {
                  "user_condition": {
                    "data.app_role": "PARENT"
                  },
                  "data.scope": "CLASSROOM",
                  "data.classroom_id": {
                    "$in": "{{user.data.linked_student_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.author_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}