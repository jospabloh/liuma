{
  "name": "NoticeDelivery",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "notice_id": {
      "type": "string",
      "description": "Reference to Notice"
    },
    "recipient_user_id": {
      "type": "string",
      "description": "User ID del destinatario"
    },
    "recipient_role": {
      "type": "string",
      "enum": [
        "PARENT",
        "TEACHER",
        "ADMIN"
      ],
      "description": "Rol del destinatario"
    },
    "student_id": {
      "type": "string",
      "description": "Alumno asociado a la entrega"
    },
    "classroom_id": {
      "type": "string",
      "description": "Salón asociado a la entrega"
    },
    "status": {
      "type": "string",
      "enum": [
        "SENT",
        "READ",
        "ACKNOWLEDGED"
      ],
      "default": "SENT",
      "description": "Estado de entrega/lectura"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cuándo se envió"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cuándo se leyó"
    },
    "escalation_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "Límite para escalar avisos urgentes no leídos"
    },
    "escalation_status": {
      "type": "string",
      "enum": [
        "ESCALATED"
      ],
      "description": "Estado de escalación"
    }
  },
  "required": [
    "school_id",
    "notice_id",
    "recipient_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.app_role": "TEACHER"
                      }
                    },
                    {
                      "data.classroom_id": {
                        "$in": "{{user.data.assigned_classroom_ids}}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}"
                }
              ]
            },
            {
              "data.school_id": "{{user.data.school_id}}",
              "data.recipient_user_id": "{{user.id}}"
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.school_id": "{{user.data.school_id}}",
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.recipient_user_id": "{{user.id}}"
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
