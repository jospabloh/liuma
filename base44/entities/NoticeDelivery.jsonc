{
  "name": "NoticeDelivery",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "notice_id": {
      "type": "string",
      "description": "Reference to Notice"
    },
    "recipient_user_id": {
      "type": "string",
      "description": "User ID del destinatario"
    },
    "recipient_role": {
      "type": "string",
      "enum": [
        "PARENT",
        "TEACHER",
        "ADMIN"
      ],
      "description": "Rol del destinatario"
    },
    "student_id": {
      "type": "string",
      "description": "Alumno asociado a la entrega"
    },
    "classroom_id": {
      "type": "string",
      "description": "Sal\u00f3n asociado a la entrega"
    },
    "status": {
      "type": "string",
      "enum": [
        "SENT",
        "READ",
        "ACKNOWLEDGED"
      ],
      "default": "SENT",
      "description": "Estado de entrega/lectura"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cu\u00e1ndo se envi\u00f3"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cu\u00e1ndo se ley\u00f3"
    },
    "escalation_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "L\u00edmite para escalar avisos urgentes no le\u00eddos"
    },
    "escalation_status": {
      "type": "string",
      "enum": [
        "ESCALATED"
      ],
      "description": "Estado de escalaci\u00f3n"
    }
  },
  "required": [
    "school_id",
    "notice_id",
    "recipient_user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "TEACHER"
          },
          "data.classroom_id": {
            "$in": "{{user.data.assigned_classroom_ids}}"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.recipient_user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    }
  }
}