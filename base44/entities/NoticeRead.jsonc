{
  "name": "NoticeRead",
  "properties": {
    "school_id": {
      "description": "Reference to School (tenant scope)",
      "type": "string"
    },
    "notice_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "read_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "notice_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}