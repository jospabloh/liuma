{
  "name": "PaymentConcept",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "concept_type": {
      "type": "string",
      "enum": [
        "INSCRIPCION",
        "COLEGIATURA",
        "HORARIO_EXTENDIDO",
        "EVENTO",
        "OTRO"
      ],
      "default": "OTRO",
      "description": "Tipo de concepto"
    },
    "default_amount": {
      "type": "number"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "yearly",
        "once"
      ]
    },
    "allows_discounts": {
      "type": "boolean",
      "default": true,
      "description": "Si permite aplicar descuentos"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "name",
    "default_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
