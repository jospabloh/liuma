{
  "name": "PermissionOverride",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "user_profile_id": {
      "type": "string",
      "description": "UserProfile ID al que aplica el override"
    },
    "resource": {
      "type": "string",
      "description": "Recurso/módulo afectado (ej. Notice, Attendance)"
    },
    "action": {
      "type": "string",
      "description": "Acción (view, add, edit, delete, approve, export, manage_permissions, read, write)"
    },
    "effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ],
      "description": "Efecto del override"
    },
    "reason": {
      "type": "string",
      "description": "Justificación del override"
    }
  },
  "required": [
    "school_id",
    "user_profile_id",
    "resource",
    "action",
    "effect"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}