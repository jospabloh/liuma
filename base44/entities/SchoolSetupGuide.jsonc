{
  "name": "SchoolSetupGuide",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "step_number": {
      "type": "number",
      "description": "Orden del paso"
    },
    "step_name": {
      "type": "string",
      "description": "Nombre del paso"
    },
    "description": {
      "type": "string",
      "description": "Descripción detallada del paso"
    },
    "category": {
      "type": "string",
      "enum": [
        "GUARDERIA",
        "ESCUELA",
        "COLEGIO",
        "GENERAL"
      ],
      "default": "GENERAL",
      "description": "Categoría del paso"
    },
    "is_annual": {
      "type": "boolean",
      "default": false,
      "description": "Si es un paso que se revisa anualmente"
    },
    "school_year": {
      "type": "string",
      "description": "Año escolar (ej: 2025-2026)"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "Si el paso está completado"
    },
    "completed_by": {
      "type": "string",
      "description": "User ID quien completó"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Última vez que se confirmó que sigue vigente"
    },
    "confirmed_by": {
      "type": "string",
      "description": "User ID quien confirmó"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "description": "Documentos adjuntos para este paso"
    }
  },
  "required": [
    "school_id",
    "step_number",
    "step_name",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
