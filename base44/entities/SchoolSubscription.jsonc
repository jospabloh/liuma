{
  "name": "SchoolSubscription",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "inactive",
        "canceled",
        "suspended"
      ],
      "default": "trial",
      "description": "Estado comercial: trial, active, view_only (solo lectura), inactive, canceled, suspended"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de inicio del trial"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de fin del trial"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "trial",
        "monthly",
        "annual"
      ],
      "default": "trial",
      "description": "Cadencia de cobro (trial, mensual, anual)"
    },
    "license_tier": {
      "type": "string",
      "enum": [
        "start",
        "growth",
        "plus"
      ],
      "default": "start",
      "description": "Tipo de licencia: start ($999), growth ($1,999), plus ($2,999) MXN/mes"
    },
    "licensed_student_limit": {
      "type": "number",
      "default": 150,
      "description": "Número máximo de alumnos permitidos según el tier de licencia (null = ilimitado)"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de inicio de suscripción pagada"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de fin de suscripción pagada"
    },
    "license_activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que ACACIA activó la licencia"
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de vencimiento de la licencia (null si no aplica)"
    },
    "payment_reference": {
      "type": "string",
      "description": "Referencia de pago del cliente (folio, transacción, etc.)"
    },
    "activation_notes": {
      "type": "string",
      "description": "Notas internas de activación (uso ACACIA)"
    },
    "activated_by_admin": {
      "type": "string",
      "description": "Email del administrador ACACIA que activó la licencia"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la escuela tiene suscripción Mercado Pago activa (cobro externo, validación manual por ACACIA)"
    },
    "activation_fee_paid": {
      "type": "boolean",
      "default": false,
      "description": "Si se cubrió la cuota de activación inicial ($7,990 MXN única vez)"
    },
    "last_payment_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime cuando ACACIA confirmó el último pago dentro de LIUMA"
    },
    "last_payment_confirmed_by": {
      "type": "string",
      "description": "Email del admin de plataforma que confirmó el último pago"
    },
    "last_payment_period": {
      "type": "string",
      "description": "Período de facturación confirmado por ACACIA, formato YYYY-MM"
    },
    "last_payment_reference": {
      "type": "string",
      "description": "Referencia del último pago confirmado (Mercado Pago ID, folio, nota manual)"
    },
    "last_payment_notes": {
      "type": "string",
      "description": "Notas internas ACACIA del último pago confirmado"
    },
    "view_only_since": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que la cuenta pasó a solo lectura"
    },
    "welcome_message_shown": {
      "type": "boolean",
      "default": false,
      "description": "Si ya se mostró el mensaje de bienvenida al trial"
    },
    "last_reminder_sent": {
      "type": "string",
      "format": "date-time",
      "description": "Última vez que se envió recordatorio"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Razón de suspensión"
    },
    "notes": {
      "type": "string",
      "description": "Notas administrativas"
    }
  },
  "required": [
    "school_id",
    "subscription_status",
    "subscription_plan"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    }
  }
}
