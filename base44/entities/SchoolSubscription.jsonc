{
  "name": "SchoolSubscription",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "inactive",
        "canceled",
        "suspended"
      ],
      "default": "trial",
      "description": "Estado comercial: trial, active, view_only (solo lectura), inactive, canceled, suspended"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de inicio del trial"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de fin del trial"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "trial",
        "monthly",
        "annual"
      ],
      "default": "trial",
      "description": "Cadencia de cobro (trial, mensual, anual)"
    },
    "license_tier": {
      "type": "string",
      "enum": [
        "start",
        "growth",
        "plus"
      ],
      "default": "start",
      "description": "Tipo de licencia: start ($999), growth ($1,999), plus ($2,999) MXN/mes"
    },
    "licensed_student_limit": {
      "type": "number",
      "default": 150,
      "description": "N\u00famero m\u00e1ximo de alumnos permitidos seg\u00fan el tier de licencia (null = ilimitado)"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de inicio de suscripci\u00f3n pagada"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de fin de suscripci\u00f3n pagada"
    },
    "license_activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que ACACIA activ\u00f3 la licencia"
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de vencimiento de la licencia (null si no aplica)"
    },
    "payment_reference": {
      "type": "string",
      "description": "Referencia de pago del cliente (folio, transacci\u00f3n, etc.)"
    },
    "activation_notes": {
      "type": "string",
      "description": "Notas internas de activaci\u00f3n (uso ACACIA)"
    },
    "activated_by_admin": {
      "type": "string",
      "description": "Email del administrador ACACIA que activ\u00f3 la licencia"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la escuela tiene suscripci\u00f3n Mercado Pago activa (cobro externo, validaci\u00f3n manual por ACACIA)"
    },
    "activation_fee_paid": {
      "type": "boolean",
      "default": false,
      "description": "Si se cubri\u00f3 la cuota de activaci\u00f3n inicial ($7,990 MXN \u00fanica vez)"
    },
    "last_payment_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime cuando ACACIA confirm\u00f3 el \u00faltimo pago dentro de LIUMA"
    },
    "last_payment_confirmed_by": {
      "type": "string",
      "description": "Email del admin de plataforma que confirm\u00f3 el \u00faltimo pago"
    },
    "last_payment_period": {
      "type": "string",
      "description": "Per\u00edodo de facturaci\u00f3n confirmado por ACACIA, formato YYYY-MM"
    },
    "last_payment_reference": {
      "type": "string",
      "description": "Referencia del \u00faltimo pago confirmado (Mercado Pago ID, folio, nota manual)"
    },
    "last_payment_notes": {
      "type": "string",
      "description": "Notas internas ACACIA del \u00faltimo pago confirmado"
    },
    "view_only_since": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que la cuenta pas\u00f3 a solo lectura"
    },
    "welcome_message_shown": {
      "type": "boolean",
      "default": false,
      "description": "Si ya se mostr\u00f3 el mensaje de bienvenida al trial"
    },
    "last_reminder_sent": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que se envi\u00f3 recordatorio"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Raz\u00f3n de suspensi\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas administrativas"
    }
  },
  "required": [
    "school_id",
    "subscription_status",
    "subscription_plan"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}