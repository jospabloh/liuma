{
  "name": "Student",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Reference to School"
    },
    "classroom_id": {
      "type": "string",
      "description": "Reference to Classroom"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "photo_url": {
      "type": "string"
    },
    "blood_type": {
      "type": "string"
    },
    "allergies": {
      "type": "string"
    },
    "medical_notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "TEACHER"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}",
              "data.classroom_id": {
                "$in": "{{user.data.assigned_classroom_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "PARENT"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}",
              "id": {
                "$in": "{{user.data.linked_student_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "data.app_role": "TEACHER"
                  }
                },
                {
                  "data.classroom_id": {
                    "$in": "{{user.data.assigned_classroom_ids}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    }
  }
}
