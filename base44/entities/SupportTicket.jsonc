{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "description": "Human-friendly ID like LIUMA-2026-000042"
    },
    "school_id": {
      "type": "string",
      "description": "Reference to School (tenant scope)"
    },
    "requester_user_id": {
      "type": "string",
      "description": "User ID of who opened the ticket"
    },
    "requester_profile_id": {
      "type": "string",
      "description": "UserProfile id of the requester"
    },
    "requester_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "PARENT"
      ]
    },
    "requester_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "ACADEMIC",
        "PAYMENTS",
        "ACCOUNT",
        "TECHNICAL",
        "FEATURE",
        "BILLING",
        "OTHER"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "AI_RESOLVED",
        "ESCALATED",
        "IN_PROGRESS",
        "WAITING_USER",
        "RESOLVED",
        "CLOSED"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "SCHOOL_ADMIN",
        "PLATFORM"
      ]
    },
    "assignee_role": {
      "type": "string"
    },
    "channel_origin": {
      "type": "string",
      "enum": [
        "LUMI_AI",
        "MANUAL"
      ]
    },
    "ai_attempted": {
      "type": "boolean"
    },
    "ai_resolution_summary": {
      "type": "string"
    },
    "sla_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_context": {
      "type": "string",
      "description": "JSON-encoded diagnostics captured client-side when the ticket was opened (route, app version, browser, viewport, recent console warnings/errors). Read-only context for support staff."
    },
    "ai_brief": {
      "type": "object",
      "description": "Structured spec produced by the AI BA/PO intake when a FEATURE or TECHNICAL ticket is opened (user story, acceptance criteria, reproduction steps, severity, impact, etc.). The same brief is also embedded as Markdown in the seed thread message, so this field is purely additive for richer rendering."
    }
  },
  "required": [
    "ticket_number",
    "school_id",
    "requester_user_id",
    "requester_role",
    "subject",
    "category",
    "priority",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}