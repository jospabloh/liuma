{
  "name": "SupportTicketMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "Reference to SupportTicket"
    },
    "school_id": {
      "type": "string",
      "description": "Tenant scope"
    },
    "author_user_id": {
      "type": "string",
      "description": "Null for AI/SYSTEM messages"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "REQUESTER",
        "AI",
        "SCHOOL_ADMIN",
        "OWNER",
        "SYSTEM"
      ]
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "school_id",
    "author_role",
    "body"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.author_user_id": "{{user.id}}"
            },
            {
              "data.requester_user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                },
                {
                  "data.requester_user_id": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}