{
  "name": "SupportTicketMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "Reference to SupportTicket"
    },
    "school_id": {
      "type": "string",
      "description": "Tenant scope"
    },
    "author_user_id": {
      "type": "string",
      "description": "Null for AI/SYSTEM messages"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "REQUESTER",
        "AI",
        "SCHOOL_ADMIN",
        "OWNER",
        "SYSTEM"
      ]
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "school_id",
    "author_role",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.author_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.author_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}