{
  "name": "TeacherClassroom",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string",
      "description": "User ID of teacher"
    },
    "classroom_id": {
      "type": "string"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Primary teacher for classroom"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "teacher_id",
    "classroom_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$or": [
            {
              "data.school_id": "{{user.data.school_id}}",
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            },
            {
              "data.teacher_id": "{{user.id}}",
              "user_condition": {
                "data.app_role": "TEACHER"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}