{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "De quién es el perfil. Solo lo fija provisionOnboardingProfile (service role): reasignar un perfil a otro usuario nunca es una edición legítima (P7, 2026-09-29).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "school_id": {
      "type": "string",
      "description": "Escuela del perfil. Bloqueado al service role: con el campo libre, un ADMIN de la escuela A se movía a la B y exportSchoolData le devolvía los datos de B (P7, 2026-09-29).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "app_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "PARENT"
      ],
      "default": "PARENT",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "SUSPENDED"
      ],
      "default": "PENDING",
      "description": "PENDING hasta que un ADMIN de la escuela lo aprueba. Bloqueado al service role: con el campo libre, un usuario PENDING se aprobaba solo con UserProfile.update (P7, 2026-09-29).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Lo marca provisionOnboardingProfile (service role). Bloqueado para que el cliente no pueda saltarse el onboarding (P7, 2026-09-29).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "welcome_message_shown": {
      "type": "boolean",
      "default": false,
      "description": "Per-user flag: whether the trial welcome modal has been dismissed. Lives on the user's own profile (self-writable) so the billing SchoolSubscription entity can stay owner-write-only."
    },
    "pending_notification_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Admin emails already sent the 'new_user_pending' notice for this profile, written by sendNotificationEmail only. Tracked per recipient (not a single flag) so a school with several active admins gets each of them notified once, rather than the first successful send blocking the rest. rls.write:false — a client (including the PENDING user this profile belongs to) must never be able to forge or clear this to suppress/replay the notice.",
      "rls": {
        "write": false
      }
    },
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Marca de dueño de la plataforma que el cliente lee (src/lib/support/owner.js, tickets.js). Estaba sin declarar y por tanto era auto-escribible; ahora solo el dueño de la plataforma (role admin) la escribe (P7, 2026-09-29).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "school_id",
    "app_role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    // Service role only (P10 review, 2026-09-29): schoolRead scopes a whole
    // school by this row's school_id/app_role/status, and whether the live
    // engine enforces the per-field locks above on a user's OWN row was never
    // verified. The one self-edit the app makes (welcome_message_shown) goes
    // through base44/functions/markWelcomeShown.
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}