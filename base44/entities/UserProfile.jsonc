{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "PARENT"
      ],
      "default": "PARENT"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "SUSPENDED"
      ],
      "default": "PENDING"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "school_id",
    "app_role"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "data.app_role": "ADMIN"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "data.app_role": "ADMIN"
      }
    }
  }
}