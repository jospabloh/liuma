{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "TEACHER",
        "PARENT"
      ],
      "default": "PARENT",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "SUSPENDED"
      ],
      "default": "PENDING"
    },
    "phone": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "welcome_message_shown": {
      "type": "boolean",
      "default": false,
      "description": "Per-user flag: whether the trial welcome modal has been dismissed. Lives on the user's own profile (self-writable) so the billing SchoolSubscription entity can stay owner-write-only."
    }
  },
  "required": [
    "user_id",
    "school_id",
    "app_role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.school_id": "{{user.data.school_id}}"
            },
            {
              "$or": [
                {
                  "data.user_id": "{{user.id}}"
                },
                {
                  "user_condition": {
                    "data.app_role": "ADMIN"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "data.app_role": "ADMIN"
      }
    }
  }
}