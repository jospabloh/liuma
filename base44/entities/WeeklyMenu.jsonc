{
  "name": "WeeklyMenu",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "week_number": {
      "type": "number",
      "description": "Número de semana (1-8 o más)"
    },
    "year": {
      "type": "number",
      "description": "Año del menú"
    },
    "monday": {
      "type": "string",
      "description": "Menú del lunes"
    },
    "tuesday": {
      "type": "string",
      "description": "Menú del martes"
    },
    "wednesday": {
      "type": "string",
      "description": "Menú del miércoles"
    },
    "thursday": {
      "type": "string",
      "description": "Menú del jueves"
    },
    "friday": {
      "type": "string",
      "description": "Menú del viernes"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "week_number",
    "year"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}",
          "user_condition": {
            "data.app_role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}